# Local runtime data; only the empty directory marker belongs in Git.
/data/*
!/data/.gitkeep

# Python environments, dependencies, and caches.
.venv/
venv/
.collections/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage*
htmlcov/

# Local credentials and configuration.
.env
.env.*
!.env.example
.aws/
.ssh/
.gnupg/
.kube/
.docker/
.netrc
.npmrc
.pypirc
credentials.json
credentials.*.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Database copies, exports, archives, and logs.
*.sqlite*
*.db
*.db-*
*.sql
*.dump
*.bak
*.backup
*.log
*.tar
*.tar.gz
*.tgz
*.zip

# Machine-specific editor and agent files.
.DS_Store
.idea/
.vscode/
.codex/
.agents/
*.swp
*.swo
*~
